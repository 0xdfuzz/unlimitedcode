{
  "listen": "127.0.0.1:42987",
  "control": "127.0.0.1:42988",
  "allow": [
    "opencode.ai",
    "*.opencode.ai"
  ],
  "allow_ports": [
    443,
    80
  ],
  "egress": {
    "mode": "masque",
    "pool_size": 2,
    "passthrough": true,
    "direct_fallback": false
  },
  "rotate": {
    "enabled": true,
    "timeout_seconds": 45,
    "failure_cooldown_seconds": 5,
    "max_per_hour": 30,
    "max_per_day": 300
  },
  "limits": {
    "max_tunnels": 128,
    "idle_timeout_seconds": 300,
    "dial_timeout_seconds": 10
  }
}
